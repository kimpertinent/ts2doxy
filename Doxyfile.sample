# ---------------------------------------------------------------------------
# Sample Doxyfile for documenting a TypeScript / JavaScript project through
# ts2doxy.  Copy it next to your tsconfig.json, adjust PROJECT_NAME and INPUT,
# replace /abs/path/to/ts2doxy in FILTER_PATTERNS below with the path of your
# ts2doxy clone, then run `doxygen Doxyfile`.
#
# ts2doxy is not on npm; it is installed by cloning it and running `npm ci`
# inside the clone (see the README).  Run `npm install` in the project you are
# documenting as well, so that the filter's type checker can resolve its
# imports.
#
# Tested with Doxygen 1.9.8 and 1.18.0, and Graphviz 2.43.
# ---------------------------------------------------------------------------

PROJECT_NAME           = "My TypeScript Project"
PROJECT_BRIEF          = "Documented with Doxygen via ts2doxy"
OUTPUT_DIRECTORY       = doxygen-out
CREATE_SUBDIRS         = NO

# ---------------------------------------------------------------------------
# Input
# ---------------------------------------------------------------------------

INPUT                  = src
RECURSIVE              = YES
INPUT_ENCODING         = UTF-8

# Doxygen only looks at files matching FILE_PATTERNS.  `.d.ts` files are
# matched by `*.ts` as well; drop them from EXCLUDE_PATTERNS below if you want
# ambient declarations documented too.
FILE_PATTERNS          = *.ts *.tsx *.mts *.cts *.js *.jsx *.mjs *.cjs

EXCLUDE_PATTERNS       = */node_modules/* \
                         */dist/* \
                         */build/* \
                         */coverage/* \
                         *.min.js \
                         *.d.ts

EXCLUDE_SYMLINKS       = YES

# ---------------------------------------------------------------------------
# The filter
# ---------------------------------------------------------------------------

# Doxygen has no TypeScript parser.  EXTENSION_MAPPING tells it to hand these
# extensions to the C++ parser, which is the language ts2doxy translates into.
# (Doxygen does ship a `Javascript` parser, but it produces no class,
# inheritance or call graphs -- that is the whole reason for this filter.)
EXTENSION_MAPPING      = ts=C++ \
                         tsx=C++ \
                         mts=C++ \
                         cts=C++ \
                         js=C++ \
                         jsx=C++ \
                         mjs=C++ \
                         cjs=C++

# Doxygen runs `<filter> <input-file>` and parses the filter's stdout instead
# of the file.  Two things are not optional here:
#
#   * The command must be QUOTED.  Doxygen splits the value on whitespace, so
#     `*.ts=node /path/ts2doxy.js` becomes the two items `*.ts=node` and
#     `/path/ts2doxy.js` -- Doxygen complains about the missing `=` in the
#     second and runs plain `node` on your TypeScript for the first, which
#     fails with ERR_UNSUPPORTED_TYPESCRIPT_SYNTAX.
#   * Use `node` and an ABSOLUTE path to the clone.  Doxygen runs the filter
#     through /bin/sh, which does not have your interactive shell's PATH.
#
# Every extension in FILE_PATTERNS needs an entry here: an extension that is
# mapped to C++ but not filtered is parsed as raw JavaScript by Doxygen's C++
# parser, silently producing nonsense.
FILTER_PATTERNS        = *.ts="node /abs/path/to/ts2doxy/bin/ts2doxy.js" \
                         *.tsx="node /abs/path/to/ts2doxy/bin/ts2doxy.js" \
                         *.mts="node /abs/path/to/ts2doxy/bin/ts2doxy.js" \
                         *.cts="node /abs/path/to/ts2doxy/bin/ts2doxy.js" \
                         *.js="node /abs/path/to/ts2doxy/bin/ts2doxy.js" \
                         *.jsx="node /abs/path/to/ts2doxy/bin/ts2doxy.js" \
                         *.mjs="node /abs/path/to/ts2doxy/bin/ts2doxy.js" \
                         *.cjs="node /abs/path/to/ts2doxy/bin/ts2doxy.js"

# INPUT_FILTER would apply one command to every input file regardless of
# extension; FILTER_PATTERNS is preferred because it leaves Markdown, images
# and other inputs untouched.
# INPUT_FILTER         = "node /abs/path/to/ts2doxy/bin/ts2doxy.js"

# ---------------------------------------------------------------------------
# Pre-generation mode (for large projects)
# ---------------------------------------------------------------------------
#
# The filter above is already fast: the first filter run of a Doxygen run
# translates the whole tsconfig project into a cache (~/.cache/ts2doxy), and
# every later run only checks that no source changed and prints the cached
# text, about 40 ms. Nothing needs configuring for that.
#
# Pre-generation is faster still, because Doxygen then starts no filter at
# all:
#
#     node /abs/path/to/ts2doxy/bin/ts2doxy.js pregen src --out doxygen-pregen
#
# Then point Doxygen at the generated tree and remove the filter: comment out
# FILTER_PATTERNS above and use
#
#     INPUT               = doxygen-pregen
#     FILTER_SOURCE_FILES = NO
#
# EXTENSION_MAPPING is still needed. The one thing you give up is the source
# browser showing your real TypeScript: with no original file in INPUT,
# Doxygen lists the generated pseudo-code instead. Line numbers still match
# the TypeScript sources.

# Critical: keep this at NO.  ts2doxy emits every declaration on the line it
# occupies in the original file, so with FILTER_SOURCE_FILES = NO the source
# browser shows the real TypeScript and "Definition at line N" is correct.
# Setting it to YES would show the generated pseudo-code instead.
FILTER_SOURCE_FILES    = NO

# ---------------------------------------------------------------------------
# What to extract
# ---------------------------------------------------------------------------

# Undocumented declarations are translated as well, so EXTRACT_ALL makes the
# whole API show up (and is what makes the call graphs complete).
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PRIV_VIRTUAL   = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
EXTRACT_ANON_NSPACES   = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
INTERNAL_DOCS          = YES
CASE_SENSE_NAMES       = YES
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO
INHERIT_DOCS           = YES

# ts2doxy writes `@param`/`@return`/... as Javadoc-style tags and relies on
# Markdown for the prose it copies out of JSDoc comments.
#
# Keep JAVADOC_AUTOBRIEF off: ts2doxy marks the brief with `@brief` itself.
# The heuristic ends the brief at the first `.` that is not followed by a
# letter, even in the middle of an element -- a comment mentioning
# `${a}.${b}` then has its `<tt>` split across brief and detailed
# description, which Doxygen reports as an unclosed tag.
JAVADOC_AUTOBRIEF      = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

# The emitted pseudo-code uses `std::function<...>` for TypeScript function
# types; this keeps Doxygen from trying to document them as user classes.
BUILTIN_STL_SUPPORT    = YES

# There are no preprocessor directives in the generated pseudo-code.
ENABLE_PREPROCESSING   = NO

# ---------------------------------------------------------------------------
# Source browser and cross references
# ---------------------------------------------------------------------------

# Required for the call and caller graphs, not optional: Doxygen only records
# cross-references while it runs the source browser pass. With
# SOURCE_BROWSER = NO every edge ts2doxy emits is lost, and Doxygen replaces
# them with bogus self-references (measured on the test fixtures: 35 real
# edges gone, 25 invented ones in their place).
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES
VERBATIM_HEADERS       = NO

# ---------------------------------------------------------------------------
# Diagrams (this is what Doxygen gives you over TypeDoc)
# ---------------------------------------------------------------------------

HAVE_DOT               = YES
# DOT_PATH             = /usr/bin          # set if `dot` is not on PATH

# UML_LOOK renders classes as UML boxes with their attributes and operations
# instead of plain name boxes.
UML_LOOK               = YES
# 0 = no limit on the number of fields shown inside a UML box.
UML_LIMIT_NUM_FIELDS   = 0
# Show types and argument lists inside the UML boxes.
DOT_UML_DETAILS        = YES
DOT_WRAP_THRESHOLD     = 17

# Inheritance / collaboration graphs.
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
TEMPLATE_RELATIONS     = YES
DIRECTORY_GRAPH        = YES

# ts2doxy emits no `#include` directives, so these two would always be empty.
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO

# The headline feature: ts2doxy fills every function body with the (fully
# qualified) calls that function makes, which is what Doxygen needs to build
# these two.
CALL_GRAPH             = YES
CALLER_GRAPH           = YES

DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
# Raise these on large projects if graphs come out truncated ("graph is
# truncated" notice under a diagram).
DOT_GRAPH_MAX_NODES    = 100
MAX_DOT_GRAPH_DEPTH    = 0
DOT_CLEANUP            = YES
DOT_NUM_THREADS        = 0

# ---------------------------------------------------------------------------
# Output formats
# ---------------------------------------------------------------------------

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
HTML_DYNAMIC_SECTIONS  = YES
SEARCHENGINE           = YES

GENERATE_LATEX         = NO

# Machine-readable output, for post-processing the extracted model (member
# lists, protection, locations, call references) with your own tools.
GENERATE_XML           = YES
XML_OUTPUT             = xml
# Embeds the input listing in the XML. With FILTER_SOURCE_FILES = NO that is
# the original TypeScript, not the generated pseudo-code.
XML_PROGRAMLISTING     = YES

# ---------------------------------------------------------------------------
# Warnings
# ---------------------------------------------------------------------------

QUIET                  = NO
WARNINGS               = YES
# EXTRACT_ALL already documents everything, so this would only produce noise.
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO
WARN_LOGFILE           = doxygen-warnings.log
